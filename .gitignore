# =============================================================
#  CumpleHN — archivos que NO se versionan
#
#  Todo lo de acá se regenera solo. Son 540 de los 759 archivos
#  de la carpeta y 172 de los 182 MB: guardarlos no aportaría
#  nada y volvería el historial inmanejable.
# =============================================================

# --- Resultado de compilar -----------------------------------
[Bb]in/
[Oo]bj/

# --- Visual Studio -------------------------------------------
.vs/
*.suo
*.user
*.userprefs

# --- NuGet ---------------------------------------------------
#  Se reconstruye desde los packages.config, que sí se versionan.
packages/
*.nupkg

# --- Configuración local de Claude Code ----------------------
#  launch.json sí se versiona: describe cómo levantar el sitio.
#  settings.local.json es de esta máquina y no de nadie más.
.claude/settings.local.json

# --- Basura de macOS -----------------------------------------
.DS_Store
._*

# --- Archivos de bloqueo de Office ---------------------------
~$*

# --- Secretos ------------------------------------------------
#  La clave de la API del asistente y la contraseña del login
#  cumplehn_ia. El repositorio es privado, pero una clave subida
#  a GitHub se considera filtrada y hay que rotarla igual.
#  secrets.config.ejemplo sí se versiona: dice qué hay que crear.
secrets.config

# --- Registros y temporales ----------------------------------
*.log
*.tmp

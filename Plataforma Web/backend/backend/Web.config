<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>

  <!-- Única puerta de acceso a la base de datos en todo el proyecto. El
       frontend no tiene cadena de conexión ni referencia a System.Data:
       llega a los datos solamente a través de este Web Service. -->
  <connectionStrings>
    <add name="CnxCumpleHN"
         connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=BDCUMPLEHN;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=15"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <!-- Ajustes del asistente que no son secretos y sí se versionan.

       Los dos que faltan acá — la clave de la API y la cadena de conexión
       del login cumplehn_ia, que sí llevan secreto — viven en
       secrets.config, que está fuera de git. El atributo file de
       appSettings los mezcla con estos al arrancar.

       Se usa file y no configSource a propósito: configSource reemplaza
       la sección entera y exige que el archivo exista, mientras que file
       la complementa y se ignora en silencio si falta. Así el backend
       compila y arranca en una máquina recién clonada, y es el código
       del asistente el que avisa que falta la clave, con un mensaje que
       se entiende.

       La cadena del asistente va acá y no en connectionStrings porque
       configSource habría arrastrado también a CnxCumpleHN, que no
       tiene secreto que esconder — usa autenticación de Windows. -->
  <appSettings file="secrets.config">
    <!-- Modelo del asistente. Cambiar este valor y guardar alcanza: ASP.NET
         recicla la aplicación y la siguiente consulta ya usa el nuevo.

         En desarrollo va claude-sonnet-5, que cuesta alrededor de la tercera
         parte por consulta y deja probar sin cuidar cada llamada.

         La elección definitiva se decide con datos y no a ojo: las mismas
         preguntas contra cada modelo quedan guardadas en ConsultasIA con su
         respuesta y sus tokens, y esa comparación es lo que justifica la
         elección en el documento. Lo que hay que mirar no es si la respuesta
         suena bien, sino si sostiene las tres reglas que hacen defendible el
         módulo: negarse a rankear candidaturas, decir el nivel de
         verificación sin que se lo pidan, y responder que no sabe en lugar
         de completar una cifra. -->
    <add key="AsistenteModelo" value="claude-sonnet-5" />
    <add key="AsistenteEsfuerzo" value="medium" />
    <add key="AsistenteCuotaDiaria" value="20" />
    <add key="AsistenteMaxTokens" value="4096" />

    <!-- Confirmación de correo del registro ciudadano.

         ConfirmacionUrlBase apunta al FRONTEND, no acá: el backend arma el
         enlace del mensaje y no conoce por su cuenta la dirección del sitio
         público. Al publicar hay que cambiarla, o los enlaces que reciba la
         gente van a seguir apuntando a localhost.

         El remitente y su contraseña no están en este archivo sino en
         secrets.config, que no se versiona. -->
    <add key="ConfirmacionUrlBase" value="http://localhost:5080" />
    <add key="ConfirmacionHoras" value="48" />

    <add key="CorreoHost" value="smtp.gmail.com" />
    <add key="CorreoPuerto" value="587" />
    <add key="CorreoNombre" value="CumpleHN" />
    <add key="CorreoTimeoutMs" value="15000" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <!-- El asistente es la única petición larga del proyecto: la llamada al
         modelo tarda de diez a veinte segundos, y una pregunta que dé varias
         vueltas de herramientas puede tardar más. El valor de fábrica son 110
         segundos, que alcanzaría hoy pero deja poco margen.

         Los tres tiempos de espera de la cadena están escalonados de adentro
         hacia afuera, y el orden importa: acá 180, el cliente SOAP del
         frontend 210 y la petición del frontend 240. Así el que se queda sin
         tiempo primero es siempre el de más adentro, que es el único que sabe
         qué estaba haciendo. Si el de afuera se rindiera primero, el
         ciudadano vería un error mientras el backend sigue gastando tokens y
         registra la consulta como respondida.

         Solo tiene efecto con debug en false. Con debug en true ASP.NET
         ignora executionTimeout, así que en desarrollo esto no se nota. -->
    <httpRuntime targetFramework="4.7.2" executionTimeout="180" />
    <!-- Los .cs y .asmx están en UTF-8 sin BOM. Sin esto las tildes de los
         mensajes y de los datos salen corruptas. -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"
                   culture="es-HN" uiCulture="es-HN" />
  </system.web>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>

  <!-- Redirecciones de enlace del SDK de Anthropic.

       El paquete resuelve a su ensamblado de netstandard2.0 y arrastra
       trece dependencias que en .NET Framework traen versiones distintas
       de las que el propio framework ya carga — System.Memory,
       System.Buffers y System.Runtime.CompilerServices.Unsafe sobre todo.
       Sin estas redirecciones el sitio compila y falla al ejecutar, con
       un FileLoadException que nombra una versión que nadie pidió.

       La versión de destino es la del ensamblado real dentro de cada
       paquete, que no coincide con el número del paquete: System.Memory
       4.6.3 contiene el ensamblado 4.0.5.0. Se leen con
       [Reflection.AssemblyName]::GetAssemblyName sobre el dll. -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.6.0" newVersion="4.1.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.6" newVersion="10.0.0.6" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Encodings.Web" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.6" newVersion="10.0.0.6" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.6" newVersion="10.0.0.6" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.IO.Pipelines" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.6" newVersion="10.0.0.6" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.ServerSentEvents" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.1" newVersion="10.0.0.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Collections.Immutable" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.AI.Abstractions" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.5.0.0" newVersion="10.5.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
<?xml version="1.0" encoding="utf-8" ?>
<bundles version="1.0">
  <!-- De Bootstrap se aprovecha la grilla y el reset. La identidad visual de
       CumpleHN vive en cumplehn.css, que se carga al final para prevalecer. -->
  <styleBundle path="~/Content/css">
    <include path="~/Content/bootstrap.css" />
    <include path="~/Content/cumplehn.css" />
  </styleBundle>
</bundles>